# Node Environment
# REQUIRED since story 24.1 — the process now REFUSES to start if NODE_ENV is absent or
# unknown. There is no default: the previous one was "production", which silently pointed
# local tooling at the production database. One of: development, test, staging, production.
NODE_ENV=development

# Database Configuration
DATABASE_URL_DEV=postgresql://username:password@localhost:5432/musician_tools_dev
DATABASE_URL_REMOTE=postgresql://username:password@remote-host:5432/musician_tools_staging
DATABASE_URL_PROD=postgresql://username:password@remote-host:5432/musician_tools_prod

# Database Connection Options
# Only the literal string "true" enables SSL (story 24.1). Anything else — false, 0, TRUE,
# empty, absent — disables it. It used to be tested for truthiness, so this very line
# ("false") was ENABLING ssl.
DB_ENABLE_SSL=false
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=10000
DB_POOL_EVICT=1000

# Server Configuration
PORT=3001
ROOT_URL=http://localhost:5173

# Authentication
# Session signing secret — REQUIRED. The server fails to boot if it is missing
# (no fallback). In prod, set it to the value previously used for JWT_SECRET so
# existing session cookies stay valid. (Story 7.1)
SESSION_SECRET=your-session-secret-here

# Deprecated: no longer consumed by the app since story 7.1 (JWT removed). Kept
# dormant for now; safe to remove from the environment later.
JWT_SECRET=your-secret-key-here

# Admin User
ADMIN_UID=

# Optional: Slack notifications for production errors
SLACK_WEBHOOK_URL=

# Resend API
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173
